# Configuración de Conexión a Base de Datos MySQL
# Para desarrollo local (XAMPP):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mi_base
DB_SSL=false

# Para Producción en TiDB Cloud (Serverless MySQL):
# Obtén estos valores en tu panel de TiDB Cloud: https://tidbcloud.com/tidbs?orgId=1372813089209370473
# TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=xxxx.root
# TIDB_PASSWORD=tu_password_aqui
# TIDB_DATABASE=mi_base
# TIDB_ENABLE_SSL=true
